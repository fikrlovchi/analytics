# ===== Server =====
PORT=4043
# Tasodifiy uzun satr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# nginx TLS orqasida true, mahalliy HTTP test uchun false
COOKIE_SECURE=true

# ===== Admin login =====
ADMIN_USERNAME=admin
# node src/scripts/hash-password.js "parolingiz" natijasini qo'ying
ADMIN_PASSWORD_HASH=

# ===== Google Sheets (moneyReport bilan bir xil service-account) =====
# dashboard/ ildizidan nisbiy yo'l (moneyReport/credentials.json)
GOOGLE_CREDENTIALS_FILE=../credentials.json
APPSHEET_SPREADSHEET_ID=1qLlZXdRoDSfk9DWWi3mnJjASCv6HCMVGj8Gs8cVVx4w
MANUAL_SPREADSHEET_ID=1BFnvxtsXUDJ1HhEzcqDzQQPaa1SOJ9zx6pXMJuEPpYU

# ===== Sinxronizatsiya =====
SYNC_INTERVAL_MIN=30
KASSA_SYNC_DAYS=90
MANUAL_UNIT_SCALE=1000
# Kassa listi A ustunida shu so'z bo'lgan qatorгача o'qiladi (kengayadigan struktura)
KASSA_TOTAL_MARKER=ИТОГО
# ИТОГО topilmasa/xavfsizlik uchun skan chegarasi
KASSA_SCAN_LAST_ROW=60
TZ=Asia/Tashkent
